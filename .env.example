# MongoDB connection. Local dev: a local mongo. Prod: your cluster's connection string,
# set as a secret on the host and never committed.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=cognivio

# Required. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# The API refuses to start if this is missing or shorter than 32 characters.
JWT_SECRET=

# Public URL of the app, for example https://kb.example.com. Set it in production: email
# links are built from it and the session cookie is marked Secure when it is https.
PUBLIC_URL=

# Comma-separated origins allowed for CORS. The SPA is same-origin, so in prod this is
# just the app's own URL. Local dev uses the Vite ports.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated emails that can open the /admin console. Register these accounts before
# anyone else can reach the server: with email off, whoever registers the address gets it.
ADMIN_EMAILS=

# false closes sign-up once your team has registered. Recommended on a public server.
REGISTRATION_OPEN=true

# true (default) means no plan limits. false enables the free plan (one person) and the
# Teams plan, for running a hosted service.
SELF_HOSTED=true

# Email through Resend. Leave RESEND_API_KEY empty to send no email: new accounts then
# skip verification and password reset links are written to the server log. When the key
# is set, EMAIL_FROM (on your Resend-verified domain) and PUBLIC_URL are required.
RESEND_API_KEY=
EMAIL_FROM=

# Contact address for the Teams plan when SELF_HOSTED=false. Shown in the plan limit
# messages.
CONTACT_EMAIL=

# false turns off the embedding model and leaves keyword search.
EMBEDDINGS_ENABLED=true

# Behind a reverse proxy, the proxy addresses uvicorn trusts for X-Forwarded-For. Without
# it every client shares one rate limit bucket. Use * only if the app is unreachable
# except through the proxy.
# FORWARDED_ALLOW_IPS=10.0.0.5

# true in prod to hide /docs, /redoc, /openapi.json
DISABLE_DOCS=false
