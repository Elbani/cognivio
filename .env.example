# MongoDB connection. Local dev: a local mongo. Prod: your cluster's connection string,
# set as a secret on the host and never committed.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=cognivio

# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# The API refuses to start if this is missing or < 32 chars.
JWT_SECRET=

# Comma-separated origins allowed for CORS. The SPA is same-origin, so in prod this is
# just the app's own URL. Local dev uses the Vite ports.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# true on a self-hosted install to lift every Free-plan limit (docker-compose sets it).
SELF_HOSTED=false

# true in prod to hide /docs, /redoc, /openapi.json
DISABLE_DOCS=false

# Transactional email via Resend. Leave RESEND_API_KEY empty to disable email
# (sends are skipped, never an error). EMAIL_FROM must be on your Resend-verified
# domain. PUBLIC_URL is the app's public URL, used for links in emails.
RESEND_API_KEY=
EMAIL_FROM=Cognivio <noreply@cognivio.app>
PUBLIC_URL=

